<odoo>
    <record id="cotizador_page_cajas" model="ir.ui.view">
        <field name="name">cotizador.page.cajas</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="cajas" string="Cajas">
                    <group>
                            <field name="caja_tabla" />
                    </group>
                </page>

                <page name="bobinas" string="Bobinas">
                    <group>
                            <field name="bobina_tabla"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>