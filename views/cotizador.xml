<odoo>
    <!--cambios para subir a la rama nelson-->
    <record id="view_herada_mati" model="ir.ui.view">
        <field name="name">sale.order.cotizador</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

                <xpath expr="//field[(@name='payment_term_id')]" position="after">
                    <field name="gasto_envio_local" string="Gtos. Envío Local"/>
                    <!--<field name="gasto_envio_despacho" string="Gtos. Despacho"/>-->
                    <field name="dias_almacenamiento" string="cp"  invisible="1"/>
                    <field name="medio_envio" string="Tipo de Flete"/>
                    <field name="cotizador_tipo_flete_id" string="Config. Flete"/>
                    <field name="cotizador_coef_flete" string="Coef. Flete" readonly="1"/>
                    <field name="porcentaje_gasto_envio_despacho" string="% Despacho"/>
                    <field name="gasto_envio_calculado" string="Total Gastos de Desapacho"/>
                    <field name="gasto_envio_agregado" string="Agregado/Descuento" invisible="1"/>
                    <field name="dias_almacenamiento2" string="Dias de Almacenamiento"/>
                    <separator string="Tipo de Cliente"/>
                    <field name="cotizador_tipo_cliente_id" string="Tipo Cliente"/>
                    <field name="cotizador_coef_cliente" string="Coef. Cliente" readonly="1"/>
                    <separator string="Cotización"/>
                    <field name="cotizar" string="Cotizar"/>
                    <field name="usar_coef_manual" string="Usar Coef. Manual"/>
                    <field name="coef_final_manual" string="Coef. Final Manual" 
                           invisible="not usar_coef_manual"/>
                </xpath>

                <xpath expr="//field[@name='partner_shipping_id']" position="after">


                    <field name="coef_euro2dolar" string="Coef. EUR/USD" />
                    <!-- agrgué campos sub total 1 pesoreal variacionpeso-->
                    <field name="subtotal1_precio" decoration-bf="1" readonly="1"/>
                    <field name="peso_real" readonly="1"/>

                    <field name="coef_subtotal2" style="width:20" string="Variación Peso"/>

                    <field name="peso_adicional" style="width:20" string="Peso embalaje"/>

                    <field name="peso_por_variacion" readonly="1"/>

                    <field name="subtotal2_flete" string="Sub Total 2" decoration-bf="1" readonly="1"/>

                    <field name="coef_dexport" string="% Derechos" />
                    <field name="subtotal3_dexport" string="Sub Total 3" decoration-bf="1" readonly="1"/>

                    <field name="coef_utilidad" string="% Utilidad"/>
                    <field name="subtotal4_utilidad" string="Sub Total 4" decoration-bf="1" readonly="1"/>


                    <field name="valor_dolar" readonly="1"/>
                    <field name="valor_euro" readonly="1"/>
                    <field name="coef_real_euro_dolar" readonly="1" string="Coef. EUR/USD Real"/>

                    <field name="valor_dolar_blue" style="width:20" string="Valor Dólar Blue"/>
                    <field name="coef_cotizacion_blue" readonly="1" string="Coef. USD Blue/USD Real"/>

                    <separator string="Coeficientes"/>

                    <field name="activar_coef" string="Modificar porcentajes manualmente"/>
                    <field name="coef_cotizacion_manual" string="Coeficiente Manual"/>

                    <field name="coef_cotizacion" decoration-bf="1" 
                           readonly="not coef_cotizacion_manual" 
                           string="Coeficiente Final"/>
                    
                    <field name="total_compra_euros" readonly="1" string="Total Compra (EUR)"/>
                    <field name="coef_cotizacion_calculado" readonly="1" 
                           decoration-bf="1" 
                           string="Coef. Calculado (Verificación)"
                           help="Coeficiente = Precio Venta Total / (Precio Compra × Coef EUR/USD Real)"/>

                    <a>------</a>

               </xpath>

        </field>

    </record>
</odoo>