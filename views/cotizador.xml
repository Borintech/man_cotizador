<odoo>
    <record id="view_herada_mati" model="ir.ui.view">
        <field name="name">sale.order.cotizador</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

                <xpath expr="//field[(@name='payment_term_id')]" position="after">
                    <field name="gasto_envio_local" string="G. Envíos"/>
                    <field name="gasto_envio_despacho" string="G. Despacho"/>
                    <field name="dias_almacenamiento" string="cp"  invisible="1"/>
                    <field name="cotizar" string="Cotizar"/>
                    <field name="medio_envio" string="M. Envío"/>
                    <field name="dias_almacenamiento2" string="D.Almacen"/>
                </xpath>

                <xpath expr="//field[@name='partner_shipping_id']" position="after">


                                <field name="coef_euro2dolar" string="Coef.Eu2Do"/>

                                <field name="coef_subtotal2" style="width:20"/>
                                <field name="subtotal2_flete" string="-Sub2_Flete" decoration-bf="1" readonly="1"/>

                                <field name="coef_dexport" />
                                <field name="subtotal3_dexport" string="-Sub3_Exp" decoration-bf="1" readonly="1"/>

                                <field name="coef_utilidad"/>
                                <field name="subtotal4_utilidad" string="-Sub4_Util" decoration-bf="1" readonly="1"/>

                                <field name="valor_dolar" string="[V.Dolar]"/>
                                <field name="valor_euro" string="[V.Euro]"/>

                                <field name="activar_coef" string="Coef_Manual?"/>

                                <field name="coef_cotizacion" decoration-bf="1" readonly="1"/>

                    <a>------</a>

               </xpath>

        </field>

    </record>
</odoo>