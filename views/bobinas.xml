<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bobinas_view" model="ir.actions.act_window">
        <field name="name">Bobinas</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">cotizador.bobinas</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>


     <record id="cotizador_bobinas_tree" model="ir.ui.view">
        <field name="name">cotizador.bobinas.tree</field>
        <field name="model">cotizador.bobinas</field>
        <field name="arch" type="xml">
                    <tree multi_edit = "1">
                                <field name="m_bobinas"/>
                                <field name="peso_bruto"/>
                                <field name="peso_vol"/>
                    </tree>
        </field>
    </record>


     <record id="cotizador_bobinas_form" model="ir.ui.view">
        <field name="name">cotizador.bobinas.form</field>
        <field name="model">cotizador.bobinas</field>
        <field name="arch" type="xml">
                    <form>
                            <sheet>
                                <group>
                                    <field name="m_bobinas"/>
                                    <field name="peso_bruto"/>
                                    <field name="peso_vol"/>
                                </group>
                            </sheet>
                    </form>
        </field>
     </record>


    <!--<menuitem id="menu_cotizador"
              name="Cotizador"
              /> -->

    <menuitem id="menu_cotizador_bobinas"
              name="Bobinas"
              parent="menu_cotizador"
              action="bobinas_view"
              />

    <!--<menuitem id="menu_cotizador_analitico"
          name="Analitico"
          parent="menu_cotizador"
          action="costos_almacenamiento_view"
          /> -->

</odoo>